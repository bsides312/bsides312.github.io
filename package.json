{
	"name": "bsides312-website",
	"description": "BSides312 - Chicago's Biggest Little Non-Profit Cybersecurity Conference",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"serve": "python3 -m http.server 8000",
		"serve-alt": "npx http-server -p 8000"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^26.4.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.4.0",
		"terser": "^5.46.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.55.0",
		"vite": "^8.0.8"
	},
	"keywords": [
		"bsides",
		"cybersecurity",
		"conference",
		"chicago",
		"hacking",
		"Cybersecurity"
	],
	"author": "BSides312 Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bsides312/bsides312.github.io.git"
	},
	"homepage": "https://bsides312.org"
}
